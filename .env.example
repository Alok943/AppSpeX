# OneAtlas — environment variables
# Copy this file to `.env.local` and fill in the keys you have.
# `.env.local` is git-ignored. Never commit real keys.

# --- Providers fully wired in this build (free tiers available) ---
# Groq:        https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenRouter:  https://openrouter.ai/keys   (also the universal fallback)
OPENROUTER_API_KEY=

# --- Supported via routing config, but optional ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GOOGLE_AI_API_KEY=
